# StockPilot agent — copy to .env and fill in. NEVER commit .env.
# The agent/deployer private key lives in ../agent-wallet.json (testnet only).
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
BASE_MAINNET_RPC_URL=https://mainnet.base.org
# Contract addresses (fill in after deployment to Base Sepolia):
STOCKPILOT_VAULT_ADDRESS=
PAPER_MARKET_ADDRESS=
TEST_ORACLE_ADDRESS=
# Free LLM for trade rationales (Pollinations, no key):
POLLINATIONS_API_URL=https://text.pollinations.ai/
# Trading params (defaults shown):
PORTFOLIO_ID=1
TRADE_USDC_AMOUNT=100000000
SELL_FRACTION_BPS=10000
